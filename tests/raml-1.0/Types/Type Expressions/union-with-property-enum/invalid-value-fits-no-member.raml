#%RAML 1.0
title: Scheduling API

# Tuesday18 is a string, but neither member's enum allows it.
types:
  PossibleMeetingDates:
    properties:
      daysAllowed:
        type: string
        enum: [Monday12, Wednesday7, Friday3]
  PossibleVacationDates:
    properties:
      daysAllowed:
        type: string
        enum: [Feb1, Feb22]
  ScheduledDays:
    type: PossibleMeetingDates | PossibleVacationDates
    properties:
      daysAllowed:
        type: string
        enum: [Feb1, Tuesday18]
