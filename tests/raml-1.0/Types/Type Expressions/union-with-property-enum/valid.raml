#%RAML 1.0
title: Scheduling API

# Each value of the enum written beside the union fits one member: Feb1 the
# vacation dates, Monday12 the meeting dates. Neither member allows both.
types:
  PossibleMeetingDates:
    properties:
      daysAllowed:
        type: string
        enum: [Monday12, Wednesday7, Friday3]
  PossibleVacationDates:
    properties:
      daysAllowed:
        type: string
        enum: [Feb1, Feb22]
  ScheduledDays:
    type: PossibleMeetingDates | PossibleVacationDates
    properties:
      daysAllowed:
        type: string
        enum: [Feb1, Monday12]
    example:
      daysAllowed: Feb1
